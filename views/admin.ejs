<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Control Panel | Rentify Car</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --sidebar-bg: #0f172a;
            --sidebar-border: #1e293b;
            --bg-color: #f1f5f9;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --success: #10b981;
            --success-bg: #ecfdf5;
            --warning: #f59e0b;
            --warning-bg: #fffbeb;
            --danger: #ef4444;
            --danger-bg: #fef2f2;
            --sidebar-w: 260px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
        }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-w);
            background: var(--sidebar-bg);
            color: white;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            z-index: 100;
            box-shadow: 4px 0 20px rgba(0,0,0,0.2);
        }

        .sidebar-header {
            padding: 24px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--sidebar-border);
        }

        .logo-box {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: white;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
        }

        .brand-text h2 {
            font-size: 19px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .brand-text span {
            font-size: 11px;
            background: #f59e0b;
            color: #78350f;
            padding: 2px 7px;
            border-radius: 6px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .nav-section-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #64748b;
            padding: 24px 20px 8px;
            font-weight: 700;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            color: #cbd5e1;
            text-decoration: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            transition: all 0.2s ease;
        }

        .menu-link i {
            font-size: 19px;
            color: #94a3b8;
        }

        .menu-link:hover {
            background: rgba(255, 255, 255, 0.08);
            color: white;
        }

        .menu-link.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
        }

        .menu-link.active i {
            color: white;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 16px;
            border-top: 1px solid var(--sidebar-border);
        }

        .admin-card {
            background: rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

        .admin-avatar {
            width: 38px;
            height: 38px;
            background: #f59e0b;
            color: #78350f;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
        }

        .admin-name {
            font-size: 13px;
            font-weight: 700;
            color: white;
        }

        .admin-role {
            font-size: 11px;
            color: #94a3b8;
        }

        .user-switch-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px;
            background: rgba(37, 99, 235, 0.2);
            color: #93c5fd;
            border-radius: 8px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .user-switch-link:hover {
            background: rgba(37, 99, 235, 0.3);
            color: white;
        }

        .logout-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 9px;
            background: rgba(239, 68, 68, 0.15);
            color: #fca5a5;
            text-decoration: none;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 700;
        }

        .logout-btn:hover {
            background: rgba(239, 68, 68, 0.25);
            color: #fee2e2;
        }

        /* MAIN */
        .admin-main {
            margin-left: var(--sidebar-w);
            width: calc(100% - var(--sidebar-w));
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* TOPBAR */
        .topbar {
            height: 72px;
            background: var(--card-bg);
            border-bottom: 1px solid var(--border);
            padding: 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .topbar-title h1 {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.3px;
        }

        .topbar-title p {
            font-size: 12.5px;
            color: var(--text-muted);
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .live-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12.5px;
            font-weight: 700;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        /* CONTENT */
        .admin-content {
            padding: 32px;
            flex: 1;
        }

        /* TOAST */
        #adminToast {
            display: none;
            position: fixed;
            top: 24px;
            right: 24px;
            background: #0f172a;
            color: white;
            padding: 14px 22px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            font-size: 13.5px;
            font-weight: 600;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* STATS GRID */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 18px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
            transition: all 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
        }

        .stat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .stat-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .stat-icon.green { background: #dcfce7; color: #15803d; }
        .stat-icon.amber { background: #fef3c7; color: #b45309; }
        .stat-icon.blue { background: #dbeafe; color: #1d4ed8; }
        .stat-icon.purple { background: #ede9fe; color: #6d28d9; }
        .stat-icon.slate { background: #f1f5f9; color: #475569; }

        .stat-value {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 4px;
        }

        .stat-sub {
            font-size: 11.5px;
            color: var(--text-muted);
            font-weight: 600;
        }

        /* SECTION CARD */
        .section-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 18px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(15, 23, 42, 0.03);
            overflow: hidden;
        }

        .section-card-header {
            padding: 22px 26px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }

        .section-heading h2 {
            font-size: 18px;
            font-weight: 800;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-heading p {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 3px;
        }

        /* FLEET GRID ("Check which car is booked or not") */
        .fleet-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
            gap: 20px;
            padding: 26px;
        }

        .fleet-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.25s ease;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .fleet-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
        }

        .fleet-img-wrap {
            height: 155px;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            position: relative;
            border-bottom: 1px solid var(--border);
        }

        .fleet-img-wrap img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: transform 0.3s;
        }

        .fleet-card:hover .fleet-img-wrap img {
            transform: scale(1.06);
        }

        .status-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        }

        .status-badge.available {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
        }

        .status-badge.booked {
            background: #fff1f2;
            color: #be123c;
            border: 1px solid #fecdd3;
        }

        .fleet-body {
            padding: 18px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .fleet-title-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .fleet-title-row h3 {
            font-size: 17px;
            font-weight: 800;
        }

        .fleet-price {
            font-size: 15px;
            font-weight: 800;
            color: var(--primary);
        }

        .fleet-cat {
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        .fleet-specs {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #f8fafc;
            padding: 8px 12px;
            border-radius: 10px;
            font-size: 11.5px;
            color: #475569;
            margin-bottom: 14px;
            border: 1px solid #f1f5f9;
        }

        .booking-callout {
            background: #fffbeb;
            border: 1px solid #fef3c7;
            border-radius: 10px;
            padding: 10px 12px;
            margin-top: auto;
            font-size: 11.5px;
        }

        .booking-callout strong {
            display: block;
            color: #92400e;
            font-size: 12px;
            margin-bottom: 2px;
        }

        .booking-callout span {
            color: #b45309;
        }

        /* CONTROLS & FILTERS */
        .filter-group {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            padding: 7px 14px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.2s;
        }

        .filter-btn.active, .filter-btn:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .search-box {
            position: relative;
        }

        .search-box input {
            padding: 8px 14px 8px 36px;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 13px;
            outline: none;
            width: 240px;
            background: #f8fafc;
            transition: all 0.2s;
        }

        .search-box input:focus {
            background: white;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        .search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 16px;
        }

        /* TABLE */
        .table-responsive {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        thead th {
            background: #f8fafc;
            color: #475569;
            text-align: left;
            padding: 14px 20px;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            border-bottom: 1px solid var(--border);
            font-weight: 700;
        }

        tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background 0.15s;
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        tbody td {
            padding: 16px 20px;
            vertical-align: middle;
        }

        .customer-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .cust-avatar {
            width: 36px;
            height: 36px;
            background: #e0e7ff;
            color: #3730a3;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        .cust-name {
            font-weight: 700;
            color: var(--text-dark);
        }

        .cust-meta {
            font-size: 11.5px;
            color: var(--text-muted);
        }

        .car-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .car-thumb {
            width: 44px;
            height: 34px;
            background: #f1f5f9;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2px;
        }

        .car-thumb img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        /* BADGES */
        .pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 14px;
            font-size: 11.5px;
            font-weight: 700;
        }

        .pill-paid { background: #dcfce7; color: #15803d; }
        .pill-unpaid { background: #fef3c7; color: #b45309; }
        .pill-confirmed { background: #e0e7ff; color: #3730a3; }
        .pill-cancelled { background: #fee2e2; color: #991b1b; }

        /* ACTION BUTTONS */
        .action-cell {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-action {
            border: none;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 11.5px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .btn-mark-paid {
            background: #10b981;
            color: white;
            box-shadow: 0 2px 6px rgba(16, 185, 129, 0.25);
        }

        .btn-mark-paid:hover {
            background: #059669;
        }

        .btn-mark-unpaid {
            background: #f1f5f9;
            color: #64748b;
            border: 1px solid #cbd5e1;
        }

        .btn-mark-unpaid:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

        .btn-confirm-booking {
            background: #3b82f6;
            color: white;
        }

        .btn-confirm-booking:hover {
            background: #2563eb;
        }

        .btn-del {
            background: #fee2e2;
            color: #dc2626;
            padding: 6px 10px;
        }

        .btn-del:hover {
            background: #fecdd3;
        }

        /* MODAL */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-box {
            background: white;
            border-radius: 20px;
            width: 100%;
            max-width: 520px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            animation: zoomIn 0.2s ease;
        }

        @keyframes zoomIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        .modal-header {
            padding: 20px 24px;
            background: #f8fafc;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-body {
            padding: 24px;
        }

        @media (max-width: 1200px) {
            .stats-grid { grid-template-columns: repeat(3, 1fr); }
        }

        @media (max-width: 900px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .sidebar { transform: translateX(-100%); }
            .admin-main { margin-left: 0; width: 100%; }
        }
    </style>
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar">
    <div class="sidebar-header">
        <div class="logo-box">
            <i class="ri-shield-keyhole-line"></i>
        </div>
        <div class="brand-text">
            <h2>Rentify</h2>
            <span>Admin Master</span>
        </div>
    </div>

    <div class="nav-section-title">Navigation</div>
    <ul class="sidebar-menu">
        <li>
            <button class="menu-link active" onclick="switchSection('dashboard', this)">
                <i class="ri-dashboard-fill"></i>
                <span>Dashboard Overview</span>
            </button>
        </li>
        <li>
            <button class="menu-link" onclick="switchSection('fleet-section', this)">
                <i class="ri-roadster-fill"></i>
                <span>Fleet & Booked Status</span>
            </button>
        </li>
        <li>
            <button class="menu-link" onclick="switchSection('bookings-section', this)">
                <i class="ri-file-list-3-fill"></i>
                <span>Bookings & Payments</span>
            </button>
        </li>
        <li>
            <button class="menu-link" onclick="switchSection('users-section', this)">
                <i class="ri-user-star-fill"></i>
                <span>Customers (<%= totalUsers %>)</span>
            </button>
        </li>
    </ul>

    <div class="sidebar-footer">
        <div class="admin-card">
            <div class="admin-avatar">
                <%= (adminUser.username || 'A').charAt(0).toUpperCase() %>
            </div>
            <div>
                <div class="admin-name"><%= adminUser.username %></div>
                <div class="admin-role">Super Administrator</div>
            </div>
        </div>

        <a href="/profile" class="user-switch-link">
            <i class="ri-external-link-line"></i>
            <span>Switch to User View</span>
        </a>

        <a href="/logout" class="logout-btn">
            <i class="ri-shut-down-line"></i>
            <span>Logout Session</span>
        </a>
    </div>
</aside>

<!-- MAIN -->
<div class="admin-main">
    <!-- TOPBAR -->
    <header class="topbar">
        <div class="topbar-title">
            <h1>Car Rental Admin Dashboard</h1>
            <p>Control bookings, mark cash/online payments as paid, and monitor fleet status</p>
        </div>

        <div class="topbar-actions">
            <div class="live-indicator">
                <div class="pulse-dot"></div>
                <span>Fleet Live Control</span>
            </div>
            <a href="/gudu" style="text-decoration:none;font-size:13px;font-weight:700;color:var(--primary);padding:8px 14px;border:1px solid #bfdbfe;border-radius:8px;">
                <i class="ri-global-line"></i> View Customer Site
            </a>
        </div>
    </header>

    <!-- CONTENT -->
    <main class="admin-content">

        <!-- METRIC CARDS -->
        <div class="stats-grid">
            <!-- REVENUE -->
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Total Revenue</span>
                    <div class="stat-icon green">
                        <i class="ri-money-rupee-circle-fill"></i>
                    </div>
                </div>
                <div class="stat-value" id="statRevenue">₹<%= Number(totalRevenue || 0).toLocaleString('en-IN') %></div>
                <div class="stat-sub"><%= paidBookingsCount %> paid reservations</div>
            </div>

            <!-- PENDING MONEY -->
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Pending Payment</span>
                    <div class="stat-icon amber">
                        <i class="ri-hand-coin-fill"></i>
                    </div>
                </div>
                <div class="stat-value" id="statPendingMoney">₹<%= Number(pendingMoney || 0).toLocaleString('en-IN') %></div>
                <div class="stat-sub"><%= unpaidBookingsCount %> counter / unpaid bookings</div>
            </div>

            <!-- BOOKED CARS -->
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Booked Cars</span>
                    <div class="stat-icon blue">
                        <i class="ri-car-fill"></i>
                    </div>
                </div>
                <div class="stat-value"><%= totalBookedCars %> / <%= totalFleetCars %></div>
                <div class="stat-sub"><%= availableCars %> cars ready to rent</div>
            </div>

            <!-- TOTAL BOOKINGS -->
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Total Bookings</span>
                    <div class="stat-icon purple">
                        <i class="ri-calendar-check-fill"></i>
                    </div>
                </div>
                <div class="stat-value"><%= totalBookings %></div>
                <div class="stat-sub"><%= confirmedBookings %> confirmed rides</div>
            </div>

            <!-- TOTAL USERS -->
            <div class="stat-card">
                <div class="stat-header">
                    <span class="stat-title">Customers</span>
                    <div class="stat-icon slate">
                        <i class="ri-group-fill"></i>
                    </div>
                </div>
                <div class="stat-value"><%= totalUsers %></div>
                <div class="stat-sub">Registered accounts</div>
            </div>
        </div>

        <!-- ==============================================
             SECTION 1: FLEET OCCUPANCY & CAR STATUS 
             ("admin check which car is booked or not")
        =============================================== -->
        <section class="section-card" id="fleet-section">
            <div class="section-card-header">
                <div class="section-heading">
                    <h2>
                        <i class="ri-dashboard-2-line" style="color:var(--primary);"></i>
                        Fleet Status Monitor (Which car is booked or not)
                    </h2>
                    <p>Live inventory check: See available cars vs currently booked cars with booking schedule</p>
                </div>

                <div class="filter-group">
                    <button class="filter-btn active" onclick="filterFleet('all', this)">All Fleet (<%= fleet.length %>)</button>
                    <button class="filter-btn" onclick="filterFleet('available', this)">🟢 Available (<%= availableCars %>)</button>
                    <button class="filter-btn" onclick="filterFleet('booked', this)">🔴 Booked (<%= totalBookedCars %>)</button>
                </div>
            </div>

            <div class="fleet-grid">
                <% fleet.forEach(function(car) { %>
                    <div class="fleet-card" data-fleet-status="<%= car.isBooked ? 'booked' : 'available' %>">
                        <div class="fleet-img-wrap">
                            <img src="<%= car.image %>" alt="<%= car.name %>" onerror="this.src='/Thar_Roxx_602x339.png'">
                            
                            <% if (car.isBooked) { %>
                                <span class="status-badge booked">
                                    <i class="ri-close-circle-fill"></i> Booked
                                </span>
                            <% } else { %>
                                <span class="status-badge available">
                                    <i class="ri-checkbox-circle-fill"></i> Available
                                </span>
                            <% } %>
                        </div>

                        <div class="fleet-body">
                            <div class="fleet-title-row">
                                <h3><%= car.name %></h3>
                                <div class="fleet-price">₹<%= car.price %>/day</div>
                            </div>

                            <div class="fleet-cat"><%= car.category %></div>

                            <div class="fleet-specs">
                                <span><i class="ri-gas-station-line"></i> <%= car.fuel %></span>
                                <span><i class="ri-settings-4-line"></i> <%= car.trans %></span>
                                <span><i class="ri-user-line"></i> <%= car.seats %> Seats</span>
                            </div>

                            <% if (car.isBooked && car.currentBooking) { %>
                                <div class="booking-callout">
                                    <strong><i class="ri-user-follow-line"></i> Booked by: <%= car.currentBooking.userName %></strong>
                                    <span>
                                        <%= car.currentBooking.pickingDate ? new Date(car.currentBooking.pickingDate).toLocaleDateString('en-IN', {day:'numeric', month:'short'}) : 'Now' %> 
                                        &rarr; 
                                        <%= car.currentBooking.droppingDate ? new Date(car.currentBooking.droppingDate).toLocaleDateString('en-IN', {day:'numeric', month:'short'}) : 'End' %>
                                        (<%= car.currentBooking.paymentStatus === 'paid' ? 'Paid' : 'Payment Due at Counter' %>)
                                    </span>
                                </div>
                            <% } else { %>
                                <div style="margin-top:auto;padding:8px 12px;background:#f0fdf4;border-radius:10px;font-size:11.5px;color:#166534;border:1px solid #dcfce7;font-weight:600;">
                                    <i class="ri-check-line"></i> Ready for instant rental reservation
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

        <!-- ==============================================
             SECTION 2: ALL BOOKINGS & PAYMENT MANAGEMENT
             ("admin are controll the mark as paid or not")
        =============================================== -->
        <section class="section-card" id="bookings-section">
            <div class="section-card-header">
                <div class="section-heading">
                    <h2>
                        <i class="ri-money-rupee-circle-line" style="color:var(--primary);"></i>
                        All Bookings & Payment Controller
                    </h2>
                    <p>Manage customer orders, view counter payments, and click <strong>"Mark as Paid"</strong> to confirm revenue</p>
                </div>

                <div class="filter-group">
                    <div class="search-box">
                        <i class="ri-search-line"></i>
                        <input type="text" id="bookingSearch" placeholder="Search customer, car, ID...">
                    </div>

                    <button class="filter-btn active" onclick="filterTable('all', this)">All</button>
                    <button class="filter-btn" onclick="filterTable('unpaid', this)">⏳ Pending Counter</button>
                    <button class="filter-btn" onclick="filterTable('paid', this)">✅ Paid</button>
                    <button class="filter-btn" onclick="filterTable('confirmed', this)">🚗 Confirmed</button>
                    <button class="filter-btn" onclick="filterTable('cancelled', this)">❌ Cancelled</button>
                </div>
            </div>

            <div class="table-responsive">
                <table id="bookingTable">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Car</th>
                            <th>Dates & Duration</th>
                            <th>Delivery Mode</th>
                            <th>Total Amount</th>
                            <th>Payment Status</th>
                            <th>Payment Control</th>
                            <th>Booking Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (bookings && bookings.length > 0) { %>
                            <% bookings.forEach(function(b) { 
                                const pStatus = String(b.paymentStatus || 'unpaid').toLowerCase();
                                const bStatus = String(b.status || 'booked').toLowerCase();
                                const isPaid = pStatus === 'paid';
                            %>
                                <tr id="row-<%= b._id %>" 
                                    data-payment="<%= pStatus %>" 
                                    data-status="<%= bStatus %>">
                                    
                                    <!-- Customer -->
                                    <td>
                                        <div class="customer-cell">
                                            <div class="cust-avatar">
                                                <%= (b.userName || 'C').charAt(0).toUpperCase() %>
                                            </div>
                                            <div>
                                                <div class="cust-name"><%= b.userName %></div>
                                                <div class="cust-meta"><%= b.userEmail %> • <%= b.userPhone %></div>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Car -->
                                    <td>
                                        <div class="car-cell">
                                            <div class="car-thumb">
                                                <img src="<%= getCarImage(b.carName) %>" alt="<%= b.carName %>">
                                            </div>
                                            <strong><%= b.carName %></strong>
                                        </div>
                                    </td>

                                    <!-- Dates -->
                                    <td>
                                        <div>
                                            <strong><%= b.pickingDate ? new Date(b.pickingDate).toLocaleDateString('en-IN', {day:'numeric', month:'short'}) : '-' %></strong>
                                            &rarr;
                                            <strong><%= b.droppingDate ? new Date(b.droppingDate).toLocaleDateString('en-IN', {day:'numeric', month:'short'}) : '-' %></strong>
                                        </div>
                                        <div style="font-size:11px;color:var(--text-muted);margin-top:2px;">
                                            #REN-<%= String(b._id).slice(-6).toUpperCase() %>
                                        </div>
                                    </td>

                                    <!-- Delivery -->
                                    <td>
                                        <div><strong><%= b.deliveryType || 'Counter Pickup' %></strong></div>
                                        <div style="font-size:11.5px;color:var(--text-muted);max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <%= b.deliveryAddress || 'Branch Office' %>
                                        </div>
                                    </td>

                                    <!-- Amount -->
                                    <td>
                                        <strong style="font-size:14.5px;color:var(--text-dark);">
                                            ₹<%= Number(b.totalAmount || 0).toLocaleString('en-IN') %>
                                        </strong>
                                    </td>

                                    <!-- Payment Status Badge -->
                                    <td>
                                        <% if (isPaid) { %>
                                            <span class="pill pill-paid" id="badge-pay-<%= b._id %>">
                                                <i class="ri-checkbox-circle-fill"></i> Paid
                                            </span>
                                        <% } else if (pStatus === 'cash') { %>
                                            <span class="pill pill-unpaid" id="badge-pay-<%= b._id %>">
                                                <i class="ri-hand-coin-line"></i> Pay at Counter
                                            </span>
                                        <% } else { %>
                                            <span class="pill pill-unpaid" id="badge-pay-<%= b._id %>">
                                                <i class="ri-alert-line"></i> Unpaid
                                            </span>
                                        <% } %>
                                    </td>

                                    <!-- PAYMENT CONTROL (MARK AS PAID / UNPAID) -->
                                    <td>
                                        <% if (!isPaid) { %>
                                            <button class="btn-action btn-mark-paid" 
                                                    id="btn-pay-<%= b._id %>"
                                                    onclick="togglePaymentStatus('<%= b._id %>', 'paid', <%= Number(b.totalAmount || 0) %>)">
                                                <i class="ri-check-line"></i> Mark as Paid
                                            </button>
                                        <% } else { %>
                                            <button class="btn-action btn-mark-unpaid" 
                                                    id="btn-pay-<%= b._id %>"
                                                    onclick="togglePaymentStatus('<%= b._id %>', 'unpaid', <%= Number(b.totalAmount || 0) %>)">
                                                <i class="ri-arrow-go-back-line"></i> Mark Unpaid
                                            </button>
                                        <% } %>
                                    </td>

                                    <!-- Booking Status -->
                                    <td>
                                        <% if (bStatus === 'confirmed' || bStatus === 'booked') { %>
                                            <span class="pill pill-confirmed" id="badge-book-<%= b._id %>">Confirmed</span>
                                        <% } else if (bStatus === 'cancelled') { %>
                                            <span class="pill pill-cancelled" id="badge-book-<%= b._id %>">Cancelled</span>
                                        <% } else { %>
                                            <span class="pill pill-unpaid" id="badge-book-<%= b._id %>">Pending</span>
                                        <% } %>
                                    </td>

                                    <!-- Actions -->
                                    <td>
                                        <div class="action-cell">
                                            <% if (bStatus !== 'confirmed' && bStatus !== 'booked' && bStatus !== 'cancelled') { %>
                                                <button class="btn-action btn-confirm-booking" onclick="confirmBooking('<%= b._id %>')" title="Confirm">
                                                    <i class="ri-check-double-line"></i>
                                                </button>
                                            <% } %>

                                            <button class="btn-action btn-del" onclick="deleteBooking('<%= b._id %>')" title="Delete">
                                                <i class="ri-delete-bin-line"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" style="text-align:center;padding:40px;color:var(--text-muted);">
                                    No bookings found in database.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ==============================================
             SECTION 3: REGISTERED USERS
        =============================================== -->
        <section class="section-card" id="users-section">
            <div class="section-card-header">
                <div class="section-heading">
                    <h2>
                        <i class="ri-group-line" style="color:var(--primary);"></i>
                        Registered Rentify Users & Accounts
                    </h2>
                    <p>Directory of all registered accounts including customers and administrators</p>
                </div>
            </div>

            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Email Address</th>
                            <th>Phone Number</th>
                            <th>Account Role</th>
                            <th>Registration Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(function(u) { %>
                            <tr>
                                <td>
                                    <div class="customer-cell">
                                        <div class="cust-avatar" style="<%= u.role === 'admin' ? 'background:#fef3c7;color:#b45309;' : '' %>">
                                            <%= (u.username || 'U').charAt(0).toUpperCase() %>
                                        </div>
                                        <strong><%= u.username %></strong>
                                    </div>
                                </td>
                                <td><%= u.email %></td>
                                <td><%= u.phnumber || 'N/A' %></td>
                                <td>
                                    <% if (u.role === 'admin' || u.username === 'adminrentify') { %>
                                        <span class="pill" style="background:#fef3c7;color:#92400e;font-weight:800;">Administrator</span>
                                    <% } else { %>
                                        <span class="pill" style="background:#eff6ff;color:#1e40af;">Customer</span>
                                    <% } %>
                                </td>
                                <td><%= u.createdAt ? new Date(u.createdAt).toLocaleDateString('en-IN') : 'Active' %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

<!-- TOAST ALERT -->
<div id="adminToast">
    <i class="ri-checkbox-circle-fill" style="color:#10b981;font-size:18px;"></i>
    <span id="toastMsg">Action updated successfully</span>
</div>

<script>
    // Toast Helper
    function showToast(msg) {
        const toast = document.getElementById('adminToast');
        const msgSpan = document.getElementById('toastMsg');
        msgSpan.innerText = msg;
        toast.style.display = 'flex';
        setTimeout(() => {
            toast.style.display = 'none';
        }, 3000);
    }

    // Toggle Payment Status API Call (Mark as Paid / Unpaid)
    async function togglePaymentStatus(bookingId, targetStatus, amount) {
        try {
            const res = await fetch(`/admin/bookings/payment-status/${bookingId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paymentStatus: targetStatus })
            });
            const data = await res.json();

            if (res.ok) {
                showToast(data.message || `Payment marked as ${targetStatus.toUpperCase()}`);

                const row = document.getElementById(`row-${bookingId}`);
                row.setAttribute('data-payment', targetStatus);

                const badge = document.getElementById(`badge-pay-${bookingId}`);
                const btn = document.getElementById(`btn-pay-${bookingId}`);

                // Update UI elements in the table row
                if (targetStatus === 'paid') {
                    badge.className = 'pill pill-paid';
                    badge.innerHTML = '<i class="ri-checkbox-circle-fill"></i> Paid';

                    btn.className = 'btn-action btn-mark-unpaid';
                    btn.innerHTML = '<i class="ri-arrow-go-back-line"></i> Mark Unpaid';
                    btn.setAttribute('onclick', `togglePaymentStatus('${bookingId}', 'unpaid', ${amount})`);

                    // Dynamically update Revenue & Pending counters
                    updateStatsCounters(amount, -amount);
                } else {
                    badge.className = 'pill pill-unpaid';
                    badge.innerHTML = '<i class="ri-alert-line"></i> Unpaid';

                    btn.className = 'btn-action btn-mark-paid';
                    btn.innerHTML = '<i class="ri-check-line"></i> Mark as Paid';
                    btn.setAttribute('onclick', `togglePaymentStatus('${bookingId}', 'paid', ${amount})`);

                    updateStatsCounters(-amount, amount);
                }
            } else {
                alert(data.message || 'Error updating payment status');
            }
        } catch (e) {
            console.error('Payment update error:', e);
            alert('Failed to update payment status on server.');
        }
    }

    function updateStatsCounters(revChange, pendChange) {
        const revEl = document.getElementById('statRevenue');
        const pendEl = document.getElementById('statPendingMoney');

        if (revEl) {
            let currentRev = parseInt(revEl.innerText.replace(/[^0-9]/g, '')) || 0;
            currentRev = Math.max(0, currentRev + revChange);
            revEl.innerText = '₹' + currentRev.toLocaleString('en-IN');
        }

        if (pendEl) {
            let currentPend = parseInt(pendEl.innerText.replace(/[^0-9]/g, '')) || 0;
            currentPend = Math.max(0, currentPend + pendChange);
            pendEl.innerText = '₹' + currentPend.toLocaleString('en-IN');
        }
    }

    // Confirm Booking API
    async function confirmBooking(bookingId) {
        if (!confirm('Confirm this customer booking reservation?')) return;

        try {
            const res = await fetch(`/admin/bookings/confirm/${bookingId}`, {
                method: 'PUT'
            });
            const data = await res.json();
            if (res.ok) {
                showToast('Booking confirmed successfully');
                const badge = document.getElementById(`badge-book-${bookingId}`);
                if (badge) {
                    badge.className = 'pill pill-confirmed';
                    badge.innerText = 'Confirmed';
                }
            } else {
                alert(data.message || 'Error confirming booking');
            }
        } catch (err) {
            alert('Server error confirming booking');
        }
    }

    // Delete Booking API
    async function deleteBooking(bookingId) {
        if (!confirm('Are you sure you want to permanently delete this booking record?')) return;

        try {
            const res = await fetch(`/admin/bookings/${bookingId}`, {
                method: 'DELETE'
            });
            const data = await res.json();
            if (res.ok) {
                showToast('Booking record deleted');
                const row = document.getElementById(`row-${bookingId}`);
                if (row) row.remove();
            } else {
                alert(data.message || 'Error deleting booking');
            }
        } catch (err) {
            alert('Server error deleting booking');
        }
    }

    // Search Filter for Bookings Table
    const searchInput = document.getElementById('bookingSearch');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const term = this.value.toLowerCase();
            const rows = document.querySelectorAll('#bookingTable tbody tr');
            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
            });
        });
    }

    // Filter Table by Status
    function filterTable(filter, btn) {
        document.querySelectorAll('.filter-group .filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const rows = document.querySelectorAll('#bookingTable tbody tr');
        rows.forEach(row => {
            const pStatus = row.getAttribute('data-payment');
            const bStatus = row.getAttribute('data-status');

            if (filter === 'all') {
                row.style.display = '';
            } else if (filter === 'paid') {
                row.style.display = (pStatus === 'paid') ? '' : 'none';
            } else if (filter === 'unpaid') {
                row.style.display = (pStatus !== 'paid' && bStatus !== 'cancelled') ? '' : 'none';
            } else if (filter === 'confirmed') {
                row.style.display = (bStatus === 'confirmed' || bStatus === 'booked') ? '' : 'none';
            } else if (filter === 'cancelled') {
                row.style.display = (bStatus === 'cancelled') ? '' : 'none';
            }
        });
    }

    // Filter Fleet Cards (Available vs Booked)
    function filterFleet(filter, btn) {
        btn.parentElement.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const cards = document.querySelectorAll('.fleet-card');
        cards.forEach(card => {
            const status = card.getAttribute('data-fleet-status');
            if (filter === 'all') {
                card.style.display = 'flex';
            } else if (filter === status) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }

    // Switch Sidebar Sections
    function switchSection(sectionId, btn) {
        document.querySelectorAll('.sidebar-menu .menu-link').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        if (sectionId === 'dashboard') {
            document.getElementById('fleet-section').style.display = 'block';
            document.getElementById('bookings-section').style.display = 'block';
            document.getElementById('users-section').style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
            const target = document.getElementById(sectionId);
            if (target) {
                target.scrollIntoView({ behavior: 'smooth' });
            }
        }
    }
</script>

</body>
</html>
