<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css"
      rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="gudu.css" />

    <title>Rentify by Prabina - Premium Car Rental Service</title>
    <link rel="icon" type="image/png" href="/logo-white.png">
  </head>
  <body>
    <!-- HEADER & NAVIGATION -->
    <header>
      <nav>
        <div class="nav__header">
          <div class="nav__logo">
            <a href="#home" class="logo">
              <img src="/logo-white.png" alt="logo" class="logo-white" />
              <img src="/logo-dark.png" alt="logo" class="logo-dark" />
              <span id="kk">RENTIFY</span>
            </a>
          </div>
          <div class="nav__menu__btn" id="menu-btn" aria-label="Toggle menu">
            <i class="ri-menu-line"></i>
          </div>
        </div>
        <ul class="nav__links" id="nav-links">
          <li><a href="#home">Home</a></li>
          <li><a href="#deals">Rental Deals</a></li>
          <li><a href="#about">How It Works</a></li>
          <li><a href="#choose">Why Choose Us</a></li>
          <li><a href="#client">Reviews</a></li>
          <li><a href="/admin">Admin</a></li>
          <li class="nav-mode-li">
            <div class="nav-mode-switcher">
              <button type="button" class="nav-mode-btn active" id="nav-day-btn" onclick="setCarMode('day')" title="Day Mode">
                <i class="ri-sun-line"></i> Day
              </button>
              <button type="button" class="nav-mode-btn" id="nav-night-btn" onclick="setCarMode('night')" title="Night Mode">
                <i class="ri-moon-line"></i> Night
              </button>
            </div>
          </li>

          <% if (user) { %>
          <li class="nav-auth-mobile">
            <a href="/profile"><i class="ri-user-line"></i> Profile</a>
          </li>
          <li class="nav-auth-mobile">
            <a href="/logout"><i class="ri-logout-box-r-line"></i> Logout</a>
          </li>
          <% } else { %>
          <li class="nav-auth-mobile">
            <a href="/signup">Register</a>
          </li>
          <li class="nav-auth-mobile">
            <a href="/login">Login</a>
          </li>
          <% } %>
        </ul>
        <div class="nav__btns">
          <% if (!user) { %>
          <a href="/signup"><button class="btn btn-outline">Register</button></a>
          <a href="/login"><button class="btn">Login</button></a>
          <% } else { %>
          <a href="/profile"><button class="btn"><i class="ri-user-line"></i> Profile</button></a>
          <a href="/logout" class="nav__btn-logout" title="Logout"><i class="ri-logout-box-r-line"></i></a>
          <% } %>
        </div>
      </nav>

      <!-- HERO SECTION -->
      <div class="header__container" id="home">
        <div class="header__content">
          <div class="hero__badge">
            <i class="ri-shield-check-fill"></i> 100% Trusted Car Rental in India
          </div>
          <h1>Fast &amp; Easy Way to <span class="hero__brand-accent">Rent a Car</span></h1>
          <p class="section__description">
            Discover a seamless car rental experience with Rentify. Choose from a
            wide range of well-maintained premium SUVs, sedans, and electric vehicles
            at transparent daily rates.
          </p>
          <div class="hero__actions">
            <a href="#deals" class="btn hero__cta-btn">
              <i class="ri-car-fill"></i> Browse All Cars
            </a>
            <a href="#about" class="hero__secondary-btn">
              How It Works <i class="ri-arrow-down-line"></i>
            </a>
          </div>
          <div class="hero__stats">
            <div class="hero__stat-card">
              <h4>50+</h4>
              <span>Fleet Cars</span>
            </div>
            <div class="hero__stat-card">
              <h4>10K+</h4>
              <span>Happy Trips</span>
            </div>
            <div class="hero__stat-card">
              <h4>24/7</h4>
              <span>Road Assistance</span>
            </div>
          </div>
        </div>

        <div class="header__image">
          <div class="car-mode-switcher">
            <!-- <button type="button" class="mode-btn active" id="day-mode-btn" onclick="setCarMode('day')">
              <i class="ri-sun-fill"></i> Day Mode
            </button>
            <button type="button" class="mode-btn" id="night-mode-btn" onclick="setCarMode('night')">
              <i class="ri-moon-fill"></i> Night Mode
            </button> -->
          </div>
          <img src="/scerpion_day.png" alt="Scorpio N" id="hero-car-img" class="car-img-mode-transition" />
          <div class="hero-car-shadow"></div>
        </div>
      </div>
    </header>

    <!-- SEARCH BAR SECTION -->
    <section class="header__form">
      <form action="#deals">
        <div class="input__group">
          <label for="location"><i class="ri-map-pin-2-fill"></i> Pick-up Location</label>
          <input
            type="text"
            name="location"
            id="location"
            placeholder="Bhubaneswar, Puri, Cuttack..." />
        </div>
        <div class="input__group">
          <label for="start_display"><i class="ri-calendar-line"></i> Pick-up Date</label>
          <input
            type="date"
            name="start_display"
            id="start_display"
            value="<%= new Date().toISOString().split('T')[0] %>" />
        </div>
        <div class="input__group">
          <label for="stop"><i class="ri-calendar-check-line"></i> Return Date</label>
          <input
            type="date"
            name="stop"
            id="stop"
            value="<%= new Date().toISOString().split('T')[0] %>" />
        </div>
        <button class="btn hero__search-btn" type="submit">
          <i class="ri-search-2-line"></i> Search Cars
        </button>
      </form>
    </section>

