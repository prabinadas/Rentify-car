<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Dashboard | Rentify</title>
    <!-- Remix Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-light: #eff6ff;
            --sidebar-bg: #0f172a;
            --sidebar-hover: #1e293b;
            --bg-main: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --success: #10b981;
            --success-light: #ecfdf5;
            --warning: #f59e0b;
            --warning-light: #fffbeb;
            --danger: #ef4444;
            --danger-light: #fef2f2;
            --sidebar-width: 260px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
        }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            color: white;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            z-index: 100;
            transition: all 0.3s ease;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.15);
        }

        .sidebar-brand {
            padding: 24px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: white;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
        }

        .brand-title {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #ffffff;
        }

        .brand-title span {
            color: #60a5fa;
        }

        .nav-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #64748b;
            padding: 20px 20px 8px;
            font-weight: 700;
        }

        .nav-list {
            list-style: none;
            padding: 0 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            color: #cbd5e1;
            text-decoration: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .nav-link i {
            font-size: 18px;
            color: #94a3b8;
            transition: color 0.2s ease;
        }

        .nav-link:hover {
            background: rgba(255, 255, 255, 0.06);
            color: white;
        }

        .nav-link:hover i {
            color: #60a5fa;
        }

        .nav-link.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.35);
        }

        .nav-link.active i {
            color: white;
        }

        .admin-switch-btn {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #ffffff !important;
            margin: 10px 12px;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
        }

        .admin-switch-btn:hover {
            background: linear-gradient(135deg, #d97706, #b45309) !important;
        }

        .sidebar-bottom {
            margin-top: auto;
            padding: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            margin-bottom: 10px;
        }

        .user-avatar {
            width: 38px;
            height: 38px;
            background: #2563eb;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: white;
            font-size: 16px;
        }

        .user-details {
            overflow: hidden;
        }

        .user-name {
            font-size: 13.5px;
            font-weight: 700;
            color: white;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .user-email {
            font-size: 11.5px;
            color: #94a3b8;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .btn-logout {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 10px;
            background: rgba(239, 68, 68, 0.12);
            color: #fca5a5;
            text-decoration: none;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.2s;
        }

        .btn-logout:hover {
            background: rgba(239, 68, 68, 0.22);
            color: #fee2e2;
        }

        /* MAIN WRAPPER */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* TOPBAR */
        .topbar {
            height: 72px;
            background: var(--card-bg);
            border-bottom: 1px solid var(--border-color);
            padding: 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            color: var(--text-main);
            cursor: pointer;
        }

        .breadcrumb {
            font-size: 14px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .breadcrumb span {
            color: var(--text-main);
            font-weight: 700;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .btn-rent-cta {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: white;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
            transition: all 0.2s;
        }

        .btn-rent-cta:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
        }

        /* CONTENT */
        .content {
            padding: 32px;
            flex: 1;
        }

        /* TOAST ALERT */
        .alert-banner {
            background: #dbeafe;
            border-left: 4px solid var(--primary);
            color: #1e40af;
            padding: 14px 18px;
            border-radius: 10px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

        /* HERO GREETING */
        .hero-banner {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #4f46e5 100%);
            border-radius: 20px;
            padding: 32px 36px;
            color: white;
            position: relative;
            overflow: hidden;
            margin-bottom: 28px;
            box-shadow: 0 10px 25px rgba(37, 99, 235, 0.2);
        }

        .hero-banner::after {
            content: '';
            position: absolute;
            right: -40px;
            top: -40px;
            width: 240px;
            height: 240px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 50%;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 600px;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.15);
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 12px;
            backdrop-filter: blur(4px);
        }

        .hero-title {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 8px;
        }

        .hero-desc {
            font-size: 14.5px;
            color: #dbeafe;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .hero-actions {
            display: flex;
            gap: 12px;
        }

        .hero-btn {
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s;
        }

        .hero-btn-primary {
            background: white;
            color: var(--primary);
        }

        .hero-btn-primary:hover {
            background: #f1f5f9;
        }

        .hero-btn-secondary {
            background: rgba(255, 255, 255, 0.15);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .hero-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.25);
        }

        /* METRIC CARDS */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 22px;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
        }

        .stat-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .stat-icon.blue { background: #dbeafe; color: #2563eb; }
        .stat-icon.green { background: #dcfce7; color: #16a34a; }
        .stat-icon.amber { background: #fef3c7; color: #d97706; }
        .stat-icon.purple { background: #ede9fe; color: #7c3aed; }

        .stat-info span {
            display: block;
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 4px;
        }

        .stat-info h3 {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-main);
        }

        /* BOOKINGS SECTION */
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title h2 {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.3px;
        }

        .filter-tabs {
            display: flex;
            background: #e2e8f0;
            padding: 4px;
            border-radius: 12px;
            gap: 4px;
        }

        .tab-btn {
            background: transparent;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn.active {
            background: white;
            color: var(--primary);
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
        }

        /* BOOKING CARDS LIST */
        .bookings-grid {
            display: grid;
            gap: 18px;
        }

        .booking-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 18px;
            padding: 24px;
            display: grid;
            grid-template-columns: 200px 1fr auto;
            gap: 24px;
            align-items: center;
            box-shadow: 0 4px 15px rgba(15, 23, 42, 0.03);
            transition: all 0.2s ease;
        }

        .booking-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.06);
        }

        .car-thumbnail-box {
            width: 100%;
            height: 125px;
            background: #f1f5f9;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
            position: relative;
            overflow: hidden;
        }

        .car-thumbnail-box img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: transform 0.3s ease;
        }

        .booking-card:hover .car-thumbnail-box img {
            transform: scale(1.05);
        }

        .car-badge-pill {
            position: absolute;
            top: 8px;
            left: 8px;
            background: rgba(15, 23, 42, 0.75);
            color: white;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .booking-info {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .booking-header-row {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .car-title {
            font-size: 19px;
            font-weight: 800;
            color: var(--text-main);
        }

        .booking-code {
            font-size: 12px;
            color: var(--text-muted);
            background: #f1f5f9;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 600;
        }

        /* STATUS BADGES */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .badge-success { background: var(--success-light); color: var(--success); }
        .badge-warning { background: var(--warning-light); color: var(--warning); }
        .badge-danger { background: var(--danger-light); color: var(--danger); }
        .badge-info { background: #eff6ff; color: #2563eb; }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            background: #f8fafc;
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid #f1f5f9;
        }

        .detail-item span {
            display: block;
            font-size: 11.5px;
            color: var(--text-muted);
            margin-bottom: 2px;
            font-weight: 600;
        }

        .detail-item strong {
            font-size: 13.5px;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .detail-item strong i {
            color: var(--primary);
        }

        .payment-notice {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12.5px;
            color: #d97706;
            background: #fffbeb;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid #fef3c7;
        }

        /* CARD ACTION SIDE */
        .booking-action-side {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: space-between;
            min-height: 125px;
            padding-left: 16px;
            border-left: 1px solid var(--border-color);
        }

        .price-tag {
            text-align: right;
        }

        .price-tag span {
            display: block;
            font-size: 11.5px;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 700;
        }

        .price-tag strong {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-main);
        }

        .action-btns {
            display: flex;
            gap: 8px;
        }

        .btn-cancel {
            background: #fff1f2;
            border: 1px solid #fecdd3;
            color: #e11d48;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-cancel:hover {
            background: #ffe4e6;
            border-color: #fda4af;
        }

        .btn-pay-now {
            background: linear-gradient(135deg, #10b981, #059669);
            border: none;
            color: white;
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.25);
        }

        .btn-pay-now:hover {
            background: #059669;
        }

        /* EMPTY STATE */
        .empty-state {
            background: white;
            border: 1px dashed #cbd5e1;
            border-radius: 20px;
            padding: 60px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 72px;
            height: 72px;
            background: #eff6ff;
            color: var(--primary);
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            margin-bottom: 16px;
        }

        .empty-state h3 {
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .empty-state p {
            color: var(--text-muted);
            font-size: 14.5px;
            max-width: 440px;
            margin: 0 auto 20px;
        }

        /* RESPONSIVE */
        @media (max-width: 1024px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .booking-card {
                grid-template-columns: 1fr;
            }
            .booking-action-side {
                flex-direction: row;
                align-items: center;
                border-left: none;
                border-top: 1px solid var(--border-color);
                padding-left: 0;
                padding-top: 16px;
                min-height: auto;
            }
            .price-tag {
                text-align: left;
            }
        }

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }
            .sidebar.open {
                transform: translateX(0);
            }
            .main-wrapper {
                margin-left: 0;
                width: 100%;
            }
            .menu-toggle {
                display: block;
            }
            .details-grid {
                grid-template-columns: 1fr;
            }
            .stats-grid {
                grid-template-columns: 1fr;
            }
            .content {
                padding: 20px;
            }
        }
    </style>
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <div class="brand-icon">
            <i class="ri-steering-2-line"></i>
        </div>
        <div class="brand-title">Rentify<span>.car</span></div>
    </div>

    <div class="nav-label">Navigation</div>
    <ul class="nav-list">
        <li>
            <a href="/profile" class="nav-link active">
                <i class="ri-dashboard-3-line"></i>
                <span>My Bookings</span>
            </a>
        </li>
        <li>
            <a href="/gudu" class="nav-link">
                <i class="ri-car-line"></i>
                <span>Explore Cars</span>
            </a>
        </li>
        <li>
            <a href="/gudu#about" class="nav-link">
                <i class="ri-information-line"></i>
                <span>About & Pricing</span>
            </a>
        </li>
        <li>
            <a href="/gudu#contact" class="nav-link">
                <i class="ri-customer-service-2-line"></i>
                <span>24/7 Helpline</span>
            </a>
        </li>
    </ul>

    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <div class="nav-label">Administrator</div>
        <a href="/admin" class="nav-link admin-switch-btn">
            <i class="ri-shield-check-line"></i>
            <span>Admin Dashboard</span>
        </a>
    <% } %>

    <div class="sidebar-bottom">
        <div class="user-chip">
            <div class="user-avatar">
                <%= (user.username || 'U').charAt(0).toUpperCase() %>
            </div>
            <div class="user-details">
                <div class="user-name"><%= user.username %></div>
                <div class="user-email"><%= user.email || 'customer@rentify.com' %></div>
            </div>
        </div>
        <a href="/logout" class="btn-logout">
            <i class="ri-logout-box-r-line"></i>
            <span>Logout</span>
        </a>
    </div>
</aside>

<!-- MAIN CONTAINER -->
<div class="main-wrapper">
    <!-- TOPBAR -->
    <header class="topbar">
        <div class="topbar-left">
            <button class="menu-toggle" id="menuToggle">
                <i class="ri-menu-line"></i>
            </button>
            <div class="breadcrumb">
                Rentify Portal / <span>Customer Dashboard</span>
            </div>
        </div>

        <div class="topbar-right">
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <a href="/admin" style="background:#fef3c7;color:#b45309;padding:6px 12px;border-radius:8px;font-size:12px;font-weight:700;text-decoration:none;">
                    🛡️ Admin Mode
                </a>
            <% } %>
            <a href="/gudu#deals" class="btn-rent-cta">
                <i class="ri-add-circle-line"></i>
                <span>Book A New Car</span>
            </a>
        </div>
    </header>

    <!-- CONTENT -->
    <main class="content">

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert-banner">
                <div style="display:flex;align-items:center;gap:10px;">
                    <i class="ri-checkbox-circle-fill" style="font-size:20px;"></i>
                    <span><%= message %></span>
                </div>
                <i class="ri-close-line" style="cursor:pointer;" onclick="this.parentElement.style.display='none'"></i>
            </div>
        <% } %>

        <!-- HERO BANNER -->
        <div class="hero-banner">
            <div class="hero-content">
                <div class="hero-badge">
                    <i class="ri-shield-star-line"></i>
                    <span>Verified Customer Account</span>
                </div>
                <h1 class="hero-title">Welcome back, <%= user.username %>! 👋</h1>
                <p class="hero-desc">
                    Manage your car rentals, check pickup schedules, review pending or verified payments, and book luxury or SUV vehicles anytime.
                </p>
                <div class="hero-actions">
                    <a href="/gudu#deals" class="hero-btn hero-btn-primary">
                        <i class="ri-search-line"></i> Browse Fleet
                    </a>
                    <a href="#bookingsList" class="hero-btn hero-btn-secondary">
                        <i class="ri-calendar-todo-line"></i> View Active Bookings
                    </a>
                </div>
            </div>
        </div>

        <!-- STATS GRID -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="ri-calendar-check-line"></i>
                </div>
                <div class="stat-info">
                    <span>Total Bookings</span>
                    <h3><%= stats.totalBookings %></h3>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="ri-roadster-line"></i>
                </div>
                <div class="stat-info">
                    <span>Confirmed Rides</span>
                    <h3><%= stats.activeBookings %></h3>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon amber">
                    <i class="ri-time-line"></i>
                </div>
                <div class="stat-info">
                    <span>Payment Pending</span>
                    <h3><%= stats.pendingPayments %></h3>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon purple">
                    <i class="ri-wallet-3-line"></i>
                </div>
                <div class="stat-info">
                    <span>Total Paid</span>
                    <h3>₹<%= Number(stats.totalSpent || 0).toLocaleString('en-IN') %></h3>
                </div>
            </div>
        </div>

        <!-- BOOKINGS SECTION -->
        <div class="section-header" id="bookingsList">
            <div class="section-title">
                <i class="ri-car-fill" style="color:var(--primary);font-size:22px;"></i>
                <h2>My Bookings & Reservations</h2>
            </div>

            <div class="filter-tabs">
                <button class="tab-btn active" onclick="filterBookings('all', this)">All (<%= userBookings.length %>)</button>
                <button class="tab-btn" onclick="filterBookings('confirmed', this)">Active / Booked</button>
                <button class="tab-btn" onclick="filterBookings('pending-pay', this)">Pending Payment</button>
                <button class="tab-btn" onclick="filterBookings('cancelled', this)">Cancelled</button>
            </div>
        </div>

        <!-- BOOKINGS LIST -->
        <% if (userBookings && userBookings.length > 0) { %>
            <div class="bookings-grid">
                <% userBookings.forEach(function(b) { 
                    const statusStr = String(b.status || 'booked').toLowerCase();
                    const paymentStr = String(b.paymentStatus || 'unpaid').toLowerCase();
                    const isPaid = paymentStr === 'paid';
                    const isCancelled = statusStr === 'cancelled';
                %>
                    <div class="booking-card" 
                         data-status="<%= statusStr %>" 
                         data-payment="<%= paymentStr %>">
                        
                        <!-- CAR IMAGE -->
                        <div class="car-thumbnail-box">
                            <span class="car-badge-pill">RENTIFY FLEET</span>
                            <img src="<%= getCarImage(b.carName) %>" alt="<%= b.carName %>" onerror="this.src='/Thar_Roxx_602x339.png'">
                        </div>

                        <!-- BOOKING INFO -->
                        <div class="booking-info">
                            <div class="booking-header-row">
                                <h3 class="car-title"><%= b.carName %></h3>
                                <span class="booking-code">#REN-<%= String(b._id).slice(-6).toUpperCase() %></span>
                                
                                <!-- Booking Status Badge -->
                                <% if (isCancelled) { %>
                                    <span class="badge badge-danger">
                                        <i class="ri-close-circle-line"></i> Cancelled
                                    </span>
                                <% } else if (statusStr === 'confirmed' || statusStr === 'booked') { %>
                                    <span class="badge badge-success">
                                        <i class="ri-checkbox-circle-line"></i> Confirmed
                                    </span>
                                <% } else { %>
                                    <span class="badge badge-warning">
                                        <i class="ri-time-line"></i> Pending
                                    </span>
                                <% } %>

                                <!-- Payment Status Badge -->
                                <% if (isPaid) { %>
                                    <span class="badge badge-success" style="background:#e0f2fe;color:#0369a1;">
                                        <i class="ri-secure-payment-line"></i> Paid Online
                                    </span>
                                <% } else if (paymentStr === 'cash') { %>
                                    <span class="badge badge-warning">
                                        <i class="ri-hand-coin-line"></i> Pay at Counter (Pending)
                                    </span>
                                <% } else { %>
                                    <span class="badge badge-warning">
                                        <i class="ri-alert-line"></i> Payment Unpaid
                                    </span>
                                <% } %>
                            </div>

                            <!-- DETAILS SPEC -->
                            <div class="details-grid">
                                <div class="detail-item">
                                    <span>Pickup Date</span>
                                    <strong>
                                        <i class="ri-calendar-event-line"></i>
                                        <%= b.pickingDate ? new Date(b.pickingDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'N/A' %>
                                    </strong>
                                </div>

                                <div class="detail-item">
                                    <span>Drop Date</span>
                                    <strong>
                                        <i class="ri-calendar-close-line"></i>
                                        <%= b.droppingDate ? new Date(b.droppingDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'N/A' %>
                                    </strong>
                                </div>

                                <div class="detail-item">
                                    <span>Delivery Mode</span>
                                    <strong>
                                        <i class="ri-map-pin-2-line"></i>
                                        <%= b.deliveryType || 'Self Pickup' %>
                                    </strong>
                                </div>
                            </div>

                            <% if (!isPaid && !isCancelled) { %>
                                <div class="payment-notice">
                                    <i class="ri-information-line"></i>
                                    <span>
                                        <% if (paymentStr === 'cash') { %>
                                            Selected <strong>Pay at Counter</strong>: Please settle ₹<%= Number(b.totalAmount || 0).toLocaleString('en-IN') %> upon vehicle handover. The admin will verify and mark as paid.
                                        <% } else { %>
                                            Payment is pending. You can pay at counter or pay online anytime.
                                        <% } %>
                                    </span>
                                </div>
                            <% } %>
                        </div>

                        <!-- PRICE & ACTION -->
                        <div class="booking-action-side">
                            <div class="price-tag">
                                <span>Total Amount</span>
                                <strong>₹<%= Number(b.totalAmount || 0).toLocaleString('en-IN') %></strong>
                            </div>

                            <div class="action-btns">
                                <% if (!isPaid && !isCancelled) { %>
                                    <a href="/payment?carName=<%= encodeURIComponent(b.carName) %>&bookingId=<%= b._id %>" class="btn-pay-now">
                                        <i class="ri-bank-card-line"></i> Pay Online
                                    </a>
                                <% } %>

                                <% if (!isCancelled) { %>
                                    <button class="btn-cancel" onclick="cancelBooking('<%= b._id %>')">
                                        <i class="ri-close-line"></i> Cancel
                                    </button>
                                <% } %>
                            </div>
                        </div>

                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <!-- EMPTY STATE -->
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="ri-car-line"></i>
                </div>
                <h3>No car bookings found</h3>
                <p>You haven't reserved any vehicles yet. Explore our top Mahindra and Tata fleets with home delivery options.</p>
                <a href="/gudu#deals" class="btn-rent-cta" style="display:inline-flex;">
                    <i class="ri-roadster-line"></i>
                    <span>Browse & Rent Now</span>
                </a>
            </div>
        <% } %>

    </main>
</div>

<script>
    // Mobile Sidebar Toggle
    const menuToggle = document.getElementById('menuToggle');
    const sidebar = document.getElementById('sidebar');

    if (menuToggle && sidebar) {
        menuToggle.addEventListener('click', () => {
            sidebar.classList.toggle('open');
        });
    }

    // Cancel Booking Function
    async function cancelBooking(id) {
        if (!confirm('Are you sure you want to cancel this booking?')) {
            return;
        }

        try {
            const res = await fetch(`/bookings/cancel-booking/${id}`, {
                method: 'DELETE'
            });
            const data = await res.json();

            if (res.ok) {
                alert(data.message || 'Booking cancelled successfully.');
                window.location.reload();
            } else {
                alert(data.message || 'Failed to cancel booking.');
            }
        } catch (err) {
            console.error('Error cancelling booking:', err);
            alert('Server error while cancelling booking. Please try again.');
        }
    }

    // Filter Bookings Tabs
    function filterBookings(type, btn) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const cards = document.querySelectorAll('.booking-card');
        cards.forEach(card => {
            const status = card.getAttribute('data-status');
            const payment = card.getAttribute('data-payment');

            if (type === 'all') {
                card.style.display = 'grid';
            } else if (type === 'confirmed') {
                card.style.display = (status === 'confirmed' || status === 'booked') ? 'grid' : 'none';
            } else if (type === 'pending-pay') {
                card.style.display = (payment !== 'paid' && status !== 'cancelled') ? 'grid' : 'none';
            } else if (type === 'cancelled') {
                card.style.display = (status === 'cancelled') ? 'grid' : 'none';
            }
        });
    }
</script>

</body>
</html>
