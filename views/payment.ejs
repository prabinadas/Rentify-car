<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Checkout & Payment | Rentify</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --dark: #0f172a;
            --card-bg: #ffffff;
            --border: #e2e8f0;
            --success: #10b981;
            --warning: #f59e0b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
            min-height: 100vh;
            color: #1e293b;
            padding: 40px 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .checkout-wrapper {
            width: 100%;
            max-width: 880px;
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
            border: 1px solid var(--border);
            overflow: hidden;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* LEFT: SUMMARY */
        .order-summary {
            background: #f8fafc;
            padding: 36px;
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
        }

        .checkout-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 24px;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #2563eb, #6366f1);
            color: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .brand-text {
            font-size: 19px;
            font-weight: 800;
            color: var(--dark);
        }

        .car-preview {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 16px;
            text-align: center;
            margin-bottom: 24px;
        }

        .car-preview img {
            max-width: 100%;
            height: 120px;
            object-fit: contain;
            margin-bottom: 10px;
        }

        .car-preview h3 {
            font-size: 18px;
            font-weight: 800;
            color: var(--dark);
        }

        .car-preview span {
            font-size: 12.5px;
            color: #64748b;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px dashed var(--border);
            font-size: 13.5px;
        }

        .detail-row span {
            color: #64748b;
        }

        .detail-row strong {
            color: var(--dark);
            font-weight: 700;
        }

        .total-box {
            margin-top: auto;
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            align-items: baseline;
        }

        .total-box span {
            font-size: 14px;
            font-weight: 700;
            color: #475569;
        }

        .total-box strong {
            font-size: 28px;
            font-weight: 800;
            color: var(--primary);
        }

        /* RIGHT: PAYMENT OPTIONS */
        .payment-pane {
            padding: 36px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .pane-title {
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .pane-subtitle {
            font-size: 13.5px;
            color: #64748b;
            margin-bottom: 24px;
        }

        .payment-options-grid {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 24px;
        }

        .payment-card {
            border: 2px solid var(--border);
            border-radius: 16px;
            padding: 18px 20px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 16px;
            position: relative;
        }

        .payment-card:hover {
            border-color: #93c5fd;
            background: #f8fafc;
        }

        .payment-card.active {
            border-color: var(--primary);
            background: #eff6ff;
        }

        .pay-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .pay-icon.blue { background: #dbeafe; color: #2563eb; }
        .pay-icon.green { background: #dcfce7; color: #15803d; }

        .pay-info h4 {
            font-size: 15px;
            font-weight: 750;
            color: var(--dark);
            margin-bottom: 2px;
        }

        .pay-info p {
            font-size: 12px;
            color: #64748b;
        }

        .radio-circle {
            margin-left: auto;
            width: 20px;
            height: 20px;
            border: 2px solid #cbd5e1;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .payment-card.active .radio-circle {
            border-color: var(--primary);
        }

        .payment-card.active .radio-circle::after {
            content: '';
            width: 10px;
            height: 10px;
            background: var(--primary);
            border-radius: 50%;
        }

        .btn-proceed {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 750;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
        }

        .btn-online-proceed {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: white;
        }

        .btn-online-proceed:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

        .btn-counter-proceed {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            display: none;
        }

        .btn-counter-proceed:hover {
            background: #059669;
        }

        .security-badge {
            margin-top: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-size: 12px;
            color: #64748b;
        }

        /* SIMULATION MODAL */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(5px);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-box {
            background: white;
            border-radius: 20px;
            width: 100%;
            max-width: 440px;
            padding: 30px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
            text-align: center;
            position: relative;
        }

        .modal-icon {
            width: 60px;
            height: 60px;
            background: #eff6ff;
            color: #2563eb;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin-bottom: 14px;
        }

        .modal-box h3 {
            font-size: 19px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .modal-box p {
            font-size: 13.5px;
            color: #64748b;
            margin-bottom: 20px;
        }

        .mock-input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 14px;
            margin-bottom: 16px;
            outline: none;
        }

        .mock-input:focus {
            border-color: var(--primary);
        }

        .spinner {
            display: none;
            width: 24px;
            height: 24px;
            border: 3px solid rgba(255,255,255,0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @media (max-width: 768px) {
            .checkout-wrapper {
                grid-template-columns: 1fr;
            }
            .order-summary {
                border-right: none;
                border-bottom: 1px solid var(--border);
            }
        }
    </style>
</head>
<body>

<div class="checkout-wrapper">
    <!-- LEFT: ORDER SUMMARY -->
    <div class="order-summary">
        <div class="checkout-brand">
            <div class="brand-icon">
                <i class="ri-steering-2-line"></i>
            </div>
            <div class="brand-text">Rentify Checkout</div>
        </div>

        <div class="car-preview">
            <img src="<%= typeof getCarImage === 'function' ? getCarImage(carName) : '/Thar_Roxx_602x339.png' %>" alt="<%= carName %>" onerror="this.src='/Thar_Roxx_602x339.png'">
            <h3><%= carName %></h3>
            <span>Verified Fleet Vehicle</span>
        </div>

        <div class="detail-row">
            <span>Delivery Type</span>
            <strong><%= deliveryType || 'Counter Pickup' %></strong>
        </div>

        <div class="detail-row">
            <span>Pickup Date</span>
            <strong><%= pickingDate %></strong>
        </div>

        <div class="detail-row">
            <span>Drop Date</span>
            <strong><%= droppingDate %></strong>
        </div>

        <div class="detail-row">
            <span>Price Per Day</span>
            <strong>₹<%= pricePerDay %></strong>
        </div>

        <div class="total-box">
            <span>Total Payable:</span>
            <strong>₹<%= Number(totalAmount || 0).toLocaleString('en-IN') %></strong>
        </div>
    </div>

    <!-- RIGHT: PAYMENT METHODS -->
    <div class="payment-pane">
        <h2 class="pane-title">Choose Payment Method</h2>
        <p class="pane-subtitle">Select online payment or choose to pay in cash/card at the counter.</p>

        <div class="payment-options-grid">
            <!-- OPTION 1: PAY ONLINE -->
            <div class="payment-card active" id="cardOnline" onclick="selectMethod('online')">
                <div class="pay-icon blue">
                    <i class="ri-bank-card-line"></i>
                </div>
                <div class="pay-info">
                    <h4>Pay Online Now</h4>
                    <p>Instant UPI, Debit/Credit Card, Net Banking</p>
                </div>
                <div class="radio-circle"></div>
            </div>

            <!-- OPTION 2: PAY AT COUNTER -->
            <div class="payment-card" id="cardCounter" onclick="selectMethod('counter')">
                <div class="pay-icon green">
                    <i class="ri-hand-coin-line"></i>
                </div>
                <div class="pay-info">
                    <h4>Pay at Counter (Cash/Card)</h4>
                    <p>Pay when you collect your car. Admin verifies payment.</p>
                </div>
                <div class="radio-circle"></div>
            </div>
        </div>

        <!-- ONLINE ACTION -->
        <button type="button" class="btn-proceed btn-online-proceed" id="btnOnline" onclick="openOnlinePaymentModal()">
            <i class="ri-shield-check-line"></i>
            <span>Pay ₹<%= Number(totalAmount || 0).toLocaleString('en-IN') %> Online</span>
        </button>

        <!-- COUNTER ACTION FORM -->
        <form action="/payment/cash" method="POST" id="counterForm">
            <input type="hidden" name="bookingId" value="<%= typeof bookingId !== 'undefined' ? bookingId : '' %>">
            <button type="submit" class="btn-proceed btn-counter-proceed" id="btnCounter">
                <i class="ri-checkbox-circle-line"></i>
                <span>Confirm & Pay at Counter</span>
            </button>
        </form>

        <div class="security-badge">
            <i class="ri-lock-2-line"></i>
            <span>256-Bit Encrypted Secure Car Reservation</span>
        </div>
    </div>
</div>

<!-- REALISTIC INTERACTIVE ONLINE PAYMENT GATEWAY MODAL -->
<div class="modal-overlay" id="paymentModal">
    <div class="modal-box">
        <div class="modal-icon">
            <i class="ri-secure-payment-fill"></i>
        </div>
        <h3>Rentify Payment Gateway</h3>
        <p>Complete ₹<%= Number(totalAmount || 0).toLocaleString('en-IN') %> payment for <%= carName %></p>

        <div style="text-align:left;margin-bottom:12px;font-size:12.5px;font-weight:700;color:#475569;">
            Select Payment Channel:
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:16px;">
            <button type="button" class="mock-tab" style="padding:8px;border:1px solid #2563eb;background:#eff6ff;color:#2563eb;border-radius:8px;font-weight:700;font-size:12.5px;">
                <i class="ri-qr-code-line"></i> UPI / QR
            </button>
            <button type="button" class="mock-tab" style="padding:8px;border:1px solid #e2e8f0;background:#f8fafc;color:#475569;border-radius:8px;font-weight:700;font-size:12.5px;">
                <i class="ri-bank-card-2-line"></i> Card
            </button>
        </div>

        <input type="text" class="mock-input" id="upiInput" value="customer@okhdfcbank" placeholder="Enter Virtual Payment Address (UPI ID)">

        <button type="button" class="btn-proceed btn-online-proceed" id="modalPayBtn" onclick="processPayment()">
            <span class="spinner" id="paySpinner"></span>
            <span id="payBtnText">Authorize ₹<%= Number(totalAmount || 0).toLocaleString('en-IN') %></span>
        </button>

        <button type="button" style="background:none;border:none;color:#64748b;font-size:12.5px;cursor:pointer;margin-top:12px;" onclick="closeModal()">
            Cancel & Return
        </button>
    </div>
</div>

<script>
    const bookingId = "<%= typeof bookingId !== 'undefined' ? bookingId : '' %>";

    function selectMethod(method) {
        const cardOnline = document.getElementById('cardOnline');
        const cardCounter = document.getElementById('cardCounter');
        const btnOnline = document.getElementById('btnOnline');
        const btnCounter = document.getElementById('btnCounter');

        if (method === 'online') {
            cardOnline.classList.add('active');
            cardCounter.classList.remove('active');
            btnOnline.style.display = 'flex';
            btnCounter.style.display = 'none';
        } else {
            cardCounter.classList.add('active');
            cardOnline.classList.remove('active');
            btnOnline.style.display = 'none';
            btnCounter.style.display = 'flex';
        }
    }

    function openOnlinePaymentModal() {
        document.getElementById('paymentModal').style.display = 'flex';
    }

    function closeModal() {
        document.getElementById('paymentModal').style.display = 'none';
    }

    async function processPayment() {
        const spinner = document.getElementById('paySpinner');
        const btnText = document.getElementById('payBtnText');
        const payBtn = document.getElementById('modalPayBtn');

        spinner.style.display = 'inline-block';
        btnText.innerText = 'Authorizing Bank Transaction...';
        payBtn.disabled = true;

        setTimeout(async () => {
            try {
                const simulatedPaymentId = 'PAY_' + Math.random().toString(36).substring(2, 9).toUpperCase();
                
                const res = await fetch('/payment/complete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        bookingId: bookingId,
                        paymentId: simulatedPaymentId
                    })
                });

                const data = await res.json();
                if (res.ok) {
                    btnText.innerText = 'Payment Approved!';
                    setTimeout(() => {
                        window.location.href = '/profile?message=Payment Successful! Your car reservation is confirmed.';
                    }, 500);
                } else {
                    alert(data.message || 'Payment recording error');
                    payBtn.disabled = false;
                    spinner.style.display = 'none';
                    btnText.innerText = 'Authorize Payment';
                }
            } catch (err) {
                console.error('Payment error:', err);
                alert('Payment error. Please try again.');
                payBtn.disabled = false;
                spinner.style.display = 'none';
                btnText.innerText = 'Authorize Payment';
            }
        }, 1200);
    }
</script>

</body>
</html>
